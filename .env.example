APP_NAME="Medical RAG Assistant"
APP_ENV=development
DEBUG=true
PORT=8000

AUDIO_SAMPLE_RATE=16000
AUDIO_CHANNELS=1
AUDIO_RECORD_SECONDS=10
TEMP_AUDIO_DIR=./data/temp_audio

CHROMA_PERSIST_DIR=./data/chroma
CHROMA_COLLECTION=medical_papers

# Required - Get from https://console.groq.com
GROQ_API_KEY="your_groq_api_key_here"
GROQ_MODEL="llama-3.1-8b-instant"

# Optional - Get from https://elevenlabs.io
ELEVENLABS_API_KEY="your_elevenlabs_api_key_here"
ELEVENLABS_VOICE_ID="EXAVITQu4vr4xnSDxMaL"

# Optional - LangSmith tracing
LANGCHAIN_API_KEY=""
LANGCHAIN_TRACING_V2=false
LANGCHAIN_PROJECT=medical-rag

WHISPER_MODEL=base

MISTRAL_API_KEY=""

# Required for PubMed API
NCBI_API_KEY=""
NCBI_EMAIL="your_email@example.com"