# Application
APP_NAME="Medical RAG Assistant"
APP_ENV=development
APP_DEBUG=true
PORT=8000

# Audio Settings
AUDIO_SAMPLE_RATE=16000
AUDIO_CHANNELS=1
AUDIO_RECORD_SECONDS=10
TEMP_AUDIO_DIR=./data/temp_audio

# ChromaDB Vector Store
CHROMA_PERSIST_DIR=./data/chroma
CHROMA_COLLECTION=medical_papers

# Required - Get from https://console.groq.com
GROQ_API_KEY="your_groq_api_key_here"
GROQ_MODEL="openai/gpt-oss-120b"

# Optional - Get from https://elevenlabs.io
ELEVENLABS_API_KEY="your_elevenlabs_api_key_here"
ELEVENLABS_VOICE_ID="EXAVITQu4vr4xnSDxMaL"

# Optional - LangSmith tracing
LANGCHAIN_API_KEY=""
LANGCHAIN_TRACING_V2=false
LANGCHAIN_PROJECT=medical-rag

# Whisper Model for Speech-to-Text
WHISPER_MODEL=base

# Required for PubMed API - Get from https://ncbi.nlm.nih.gov
NCBI_API_KEY="your_ncbi_api_key_here"
NCBI_EMAIL="your_email@example.com"

# Frontend (Vite)
VITE_API_BASE_URL=http://localhost:8000